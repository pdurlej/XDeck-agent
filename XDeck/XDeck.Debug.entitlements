<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Required for AgentBridge NWListener on 127.0.0.1 when XDECK_AGENT=1.
	     Keep this Debug-only; do not ship to Release/Homebrew. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Mirror agent.token for CLI/MCP outside the sandbox container.
	     Prefer portable /Users/Shared (no per-user absolute paths in the plist).
	     Also keep home-relative App Support for environments where it works. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>Library/Application Support/XDeck/</string>
	</array>
	<key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
	<array>
		<string>/Users/Shared/XDeck-agent/</string>
	</array>
</dict>
</plist>
